<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TitleBarStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TitleBar Studio">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             The custom title bar.
             Everything in this row is drawn by us; the system caption
             buttons are painted on top by AppWindowTitleBar.
             ============================================================ -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: icon + title + subtitle -->
            <StackPanel
                Grid.Column="0"
                Margin="16,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Image
                    x:Name="AppIconImage"
                    Width="16"
                    Height="16"
                    Source="Assets/app-icon.png" />
                <StackPanel VerticalAlignment="Center" Spacing="-2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="TitleBar Studio" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.6"
                        Text="Mica · drag regions · icons" />
                </StackPanel>
            </StackPanel>

            <!-- Center: an interactive control living inside the title bar -->
            <AutoSuggestBox
                x:Name="TitleBarSearch"
                Grid.Column="1"
                Width="320"
                MaxWidth="420"
                Margin="8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                PlaceholderText="Search settings, files, and commands"
                QueryIcon="Find" />

            <!-- Right: our own buttons, padded away from the caption buttons -->
            <StackPanel
                x:Name="RightActions"
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="ThemeButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeButton_Click"
                    ToolTipService.ToolTip="Toggle light / dark theme">
                    <FontIcon FontSize="14" Glyph="&#xE706;" />
                </Button>
                <Button
                    x:Name="HeightButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="HeightButton_Click"
                    ToolTipService.ToolTip="Toggle standard / tall title bar">
                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                </Button>
                <ToggleButton
                    x:Name="RegionToggleButton"
                    Height="32"
                    Padding="10,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RegionToggleButton_Click"
                    ToolTipService.ToolTip="Show drag and passthrough regions">
                    <TextBlock FontSize="12" Text="Regions" />
                </ToggleButton>
                <Button
                    x:Name="SettingsButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="About this demo">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>

            <!-- Debug overlay: draws the computed non-client regions -->
            <Canvas
                x:Name="RegionOverlayCanvas"
                Grid.ColumnSpan="3"
                IsHitTestVisible="False" />
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="28,8,28,28">
            <StackPanel MaxWidth="900" Spacing="14">

                <StackPanel Margin="0,8,0,4" Spacing="6">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="A title bar that belongs to your app" />
                    <TextBlock
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        Opacity="0.75"
                        Text="Drag the window by the empty space in the title bar, click the search box, and toggle the regions overlay to see exactly which pixels Windows treats as caption (draggable) and which pixels get handed back to XAML."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Material -->
                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Window material" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Mica samples the desktop wallpaper behind the window. Acrylic blurs what is behind the window."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="MaterialCombo"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0"
                            SelectionChanged="MaterialCombo_SelectionChanged">
                            <ComboBoxItem Content="Mica (Base)" />
                            <ComboBoxItem Content="Mica Alt" />
                            <ComboBoxItem Content="Acrylic" />
                            <ComboBoxItem Content="Solid" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Height -->
                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Title bar height" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Standard is 32 px, Tall is 48 px. Windows only allows these two options; everything else is padding."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="TallSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            Header="Tall"
                            IsOn="True"
                            Toggled="TallSwitch_Toggled" />
                    </Grid>
                </Border>

                <!-- Regions -->
                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="Drag region inspector" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="Blue = caption (the window drags here). Green = passthrough (XAML gets the pointer)."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="RegionSwitch"
                                Grid.Column="1"
                                MinWidth="0"
                                Header="Overlay"
                                Toggled="RegionSwitch_Toggled" />
                        </Grid>
                        <TextBlock
                            x:Name="RegionReadout"
                            FontFamily="Consolas"
                            FontSize="12"
                            Opacity="0.7"
                            Text="drag regions idle" />
                    </StackPanel>
                </Border>

                <!-- Icons -->
                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Icons" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="AppWindow.SetIcon sets the taskbar and Alt-Tab icon. The Image in the title bar is separate XAML."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="IconSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            Header="Show in title bar"
                            IsOn="True"
                            Toggled="IconSwitch_Toggled" />
                    </Grid>
                </Border>

                <!-- Advanced -->
                <Border
                    Padding="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Advanced: manual caption regions" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="Stop using Window.SetTitleBar and describe the drag area yourself with NonClientRegionKind.Caption. Handy for complex layouts, but never mix the two."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ExplicitCaptionSwitch"
                            Grid.Column="1"
                            MinWidth="0"
                            Header="Manual"
                            Toggled="ExplicitCaptionSwitch_Toggled" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="StatusText"
                    Margin="2,4,0,0"
                    FontSize="12"
                    Opacity="0.6"
                    Text="Ready. Drag from the empty title bar area." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
